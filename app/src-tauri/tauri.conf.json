{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zoro-gravity",
  "version": "0.1.0",
  "identifier": "kr.zorogravity.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "kiosk", "title": "zoro-gravity 민원 창구", "width": 1280, "height": 800 },
      { "label": "officer", "title": "zoro-gravity 심사 콘솔", "width": 1920, "height": 1080, "maximized": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
